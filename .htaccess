RewriteEngine On


# =========================================
# CANONICAL HOST
# www -> non-www
# =========================================

RewriteCond %{HTTP_HOST} ^www\.transfer-servis52\.ru$ [NC]
RewriteRule ^ https://transfer-servis52.ru%{REQUEST_URI} [L,R=301]


# =========================================
# HIDDEN FILES AND DIRECTORIES
# =========================================

RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]


# =========================================
# CUSTOM 404
# =========================================

ErrorDocument 404 /404.html


# =========================================
# DIRECTORY PROTECTION
# =========================================

Options -Indexes


# =========================================
# SECURITY HEADERS
# =========================================

<IfModule mod_headers.c>

    Header always set X-Content-Type-Options "nosniff"

    Header always set X-Frame-Options "SAMEORIGIN"

    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

    Header always unset X-Powered-By

</IfModule>


# =========================================
# PROTECT SENSITIVE FILES
# =========================================

<FilesMatch "(?i)^(\.env|\.git|\.gitignore|composer\.(json|lock)|package(-lock)?\.json|wrangler\.toml)$">
    Require all denied
</FilesMatch>

<FilesMatch "(?i)\.(bak|backup|dist|ini|log|sql|sqlite|sqlite3|sh|ps1)$">
    Require all denied
</FilesMatch>

<Files "_proxy_auth.php">
    Require all denied
</Files>


# =========================================
# XML / SITEMAP
# =========================================

<Files "sitemap.xml">
    ForceType application/xml
    Header set Content-Type "application/xml; charset=utf-8"
</Files>

AddType application/xml .xml


# =========================================
# DEFAULT CHARSET
# =========================================

AddDefaultCharset UTF-8


# =========================================
# BROWSER CACHE
# =========================================

<IfModule mod_expires.c>

    ExpiresActive On

    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/gif "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/x-icon "access plus 30 days"

</IfModule>


<IfModule mod_headers.c>

    <FilesMatch "\.(jpg|jpeg|png|webp|gif|svg|ico)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>

</IfModule>